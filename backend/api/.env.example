# ==============================================================================
# BLYNK QUICK-COMMERCE BACKEND API - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# CRITICAL SECURITY NOTE:
# Never commit actual .env files containing production secrets to version control.
# In production (NODE_ENV=production), the application enforces strict checks:
# - JWT and OTP secrets must NOT use dev placeholders or start with 'dev_'
# - CORS_ORIGINS must NOT be '*'
# - DATABASE_URL must NOT point to localhost/127.0.0.1
# - SMS_API_KEY and SMS_USER_ID must be provided (mock SMS is prohibited)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Runtime
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
APP_NAME=blynk-backend-api

# ------------------------------------------------------------------------------
# 2. Database Connection (PostgreSQL 15+)
# ------------------------------------------------------------------------------
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
# For Docker Compose: postgresql://postgres:postgrespassword@postgres:5432/blynk_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/blynk_db

# ------------------------------------------------------------------------------
# 3. Security & Authentication
# ------------------------------------------------------------------------------
# Generate high-entropy secrets using: openssl rand -base64 32
JWT_ACCESS_SECRET=dev_jwt_access_secret_change_me_in_production_min_32_chars!
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_change_me_in_production_min_32_chars!
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# OTP HMAC secret (min 16 chars)
OTP_SECRET=dev_otp_hmac_secret_min_32_chars_random_string!
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3

# ------------------------------------------------------------------------------
# 4. CORS & Network Configuration
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins. Wildcard '*' allowed in development only.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:8081

# ------------------------------------------------------------------------------
# 5. Structured Logging (Pino)
# ------------------------------------------------------------------------------
# Supported levels: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 6. External Notification Gateways (Phase 1 SMS via NotifyLK & WhatsApp Cloud)
# ------------------------------------------------------------------------------
# In development/test, dev_ placeholders simulate mock gateway deliveries.
# In production, real credentials are strictly required.
SMS_PROVIDER=notifylk
SMS_API_KEY=dev_notifylk_api_key_placeholder
SMS_USER_ID=dev_notifylk_user_id_placeholder
SMS_SENDER_ID=Blynk

WHATSAPP_API_TOKEN=dev_whatsapp_token_placeholder
WHATSAPP_PHONE_NUMBER_ID=dev_whatsapp_phone_number_id_placeholder

# ------------------------------------------------------------------------------
# 7. Transactional Notification Outbox Worker Daemon
# ------------------------------------------------------------------------------
# In combined single-process deployment, keep true.
# In decoupled containerized deployment (separate API and Worker services):
# - Set false for the API service container
# - Set true for the dedicated Worker service container
NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_WORKER_INTERVAL_MS=3000
NOTIFICATION_WORKER_BATCH_SIZE=20
NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_PROCESSING_TIMEOUT_MS=300000
