# ==============================================================================
# BLYNK QUICK-COMMERCE BACKEND API - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
APP_NAME=blynk-backend-api

# Database Connection (PostgreSQL 15+)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/blynk_db

# Security & Authentication (JWT & Hashing Secrets)
# In production, use high-entropy random strings (e.g. openssl rand -base64 32)
JWT_ACCESS_SECRET=dev_jwt_access_secret_change_me_in_production_min_32_chars!
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_change_me_in_production_min_32_chars!
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d
OTP_SECRET=dev_otp_hmac_secret_min_32_chars_random_string!
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3

# CORS & Network Configuration (Comma-separated allowed origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081

# Structured Logging Level (trace, debug, info, warn, error, fatal)
LOG_LEVEL=info

# External Notification Providers (Phase 1 Stub/Credentials)
SMS_PROVIDER=notifylk
SMS_API_KEY=dev_notifylk_api_key_placeholder
WHATSAPP_API_TOKEN=dev_whatsapp_token_placeholder
