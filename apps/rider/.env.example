# Blynk API the Rider app talks to - the same backend as Customer, Admin and
# Inventory. No secrets belong in this file or in any VITE_* variable: they
# are compiled into the browser bundle. Authorization comes from the rider's
# own login, and every rider route is enforced server side
# (requireAuth + requireRoles('RIDER') + ownership of the delivery).
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Development only. When set, `npm run dev` shows a "Skip sign-in" button
# that runs the normal OTP flow for this rider number using the dev code the
# API returns outside production. Production builds contain no trace of it.
# Put it in .env.development.local (git-ignored), not here.
# VITE_DEV_RIDER_PHONE=07XXXXXXXX
