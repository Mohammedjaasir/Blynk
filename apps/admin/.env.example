# Blynk API the admin app talks to. No secrets belong in this file or in any
# VITE_* variable - they are compiled into the browser bundle. Authorization
# comes from the operator's own login token, and every admin route is
# enforced server side by requireAuth + requireRoles('ADMIN').
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Development only. When set, `npm run dev` shows a "Skip sign-in" button that
# runs the normal OTP flow for this admin number using the dev code the API
# returns outside production. Ignored by production builds. Put it in
# .env.development.local (git-ignored), not here.
# VITE_DEV_ADMIN_PHONE=07XXXXXXXX

# Where the Orders panel sends staff to source items (the separate Inventory
# app). Defaults to http://localhost:5174 in development.
# VITE_INVENTORY_URL=https://inventory.example
