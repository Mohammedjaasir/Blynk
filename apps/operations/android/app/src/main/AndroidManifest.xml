<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- "Take photo" for product images (components/ImageUploader.tsx). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Delivery tab (staff riders, 2026-10-01): the WebView's navigator.geolocation
         shares the operator's position while one of their deliveries is on the road.
         Capacitor's WebChromeClient asks for these at runtime on first use. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Screen-off sharing (2026-10-02): @capacitor-community/background-geolocation runs its
         watcher in a foreground service of type "location" with a visible notification
         (the plugin's own manifest also merges these in, plus its <service> and
         POST_NOTIFICATIONS). Install-time only: no extra prompt. A location service started
         while the app is open keeps while-in-use access when the screen locks, so
         ACCESS_BACKGROUND_LOCATION ("Allow all the time") is deliberately NOT requested. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Android 13+: asked for at runtime (NotificationPermissionPlugin) just before location
         sharing starts, so the "Sharing your location" notification shows in the drawer. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The plugin's manifest declares the GPS feature as required; keep it optional. -->
    <uses-feature android:name="android.hardware.location.gps" android:required="false" tools:replace="android:required" />
</manifest>
