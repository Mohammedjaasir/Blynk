# Blynk API the Operations app talks to - the same backend as Customer,
# Admin, Inventory and Rider. No secrets belong in this file or in any
# VITE_* variable: they are compiled into the browser bundle. Authorization
# comes from the operator's own login token; every route Operations calls is
# enforced server side (requireAuth + requireRoles, plus the existing
# server-side rider-ownership checks on every rider-scoped delivery route).
#
# For `npm run dev`, copy this file to .env.development.local (NOT .env.local:
# Vite reads .env.local for production builds as well). A production build
# (`npm run build`) refuses to run unless VITE_API_BASE_URL is an https
# address that is not localhost - set it for the build, e.g.
#   VITE_API_BASE_URL=https://api.blynk.lk/api/v1 npm run build && npx cap sync android
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Development only. When set, `npm run dev` shows a "Skip sign-in" button
# that runs the normal OTP flow for this operator number using the dev code
# the API returns outside production. Ignored by production builds. Put it
# in .env.development.local (git-ignored), not here.
# VITE_DEV_OPERATOR_PHONE=07XXXXXXXX

# Optional: a Google Maps Platform "Static Maps" API key for the single-pin
# clinic location map on the clinic detail screen (task F9). Unset by
# default - the screen shows an honest "Map unavailable" state instead, the
# same fallback the customer app's own map adapter uses when it has no key.
# Before ever setting this in a real environment, read
# `src/components/ClinicLocationMap.tsx`'s doc comment and
# `docs/06-deployment/google-maps-platform-setup.md` section 3: that doc
# currently says NOT to enable the Static Maps API project-wide - this needs
# a decision from whoever owns the Google Cloud project first.
# VITE_GOOGLE_MAPS_STATIC_KEY=
