# Used instead of the repo-root .dockerignore (which excludes apps/) for
# apps/customer-site/Dockerfile. Only what the build needs goes in.
*
!apps/customer-site/
!apps/customer-app/
apps/customer-app/dist/
apps/customer-app/dist-live/
apps/customer-app/.expo/
apps/customer-app/**/.env
**/.env.*
**/node_modules/
