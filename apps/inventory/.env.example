# Blynk API the Inventory app talks to - the same backend as Customer and
# Admin. No secrets belong in this file or in any VITE_* variable: they are
# compiled into the browser bundle. Authorization comes from the operator's
# own login, and every inventory route is enforced server side
# (requireAuth + requireRoles).
#
# Production builds (`vite build`) refuse to run unless this is a public
# https address - never localhost, never plain http. Set it as a build
# argument / environment variable on the build host.
VITE_API_BASE_URL=https://api.example.com/api/v1

# Local development: put the dev address in .env.development.local
# (git-ignored), e.g.
#   VITE_API_BASE_URL=http://localhost:4000/api/v1
