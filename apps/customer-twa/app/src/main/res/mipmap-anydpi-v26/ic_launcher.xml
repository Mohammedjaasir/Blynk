<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon: the Blynk "B" on white, with a themed (monochrome) layer
     for Android 13+ themed icons. Same artwork as apps/customer-app/assets/android-icon-*. -->
