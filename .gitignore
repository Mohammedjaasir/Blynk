# ==============================================================================
# BLYNK MONOREPO .GITIGNORE
# ==============================================================================

# OS and Editor
.DS_Store
*.class
*.log
*.pyc
*.swp
.history
.idea/
*.iml
*.ipr
*.iws

# Environment Variables & Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
docker-compose.override.yml

# Node.js / Backend
node_modules/
dist/
coverage/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Database & Local Volumes
postgres-data/
*.sqlite

# Flutter / Dart / Pub
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
**/doc/api/
**/ios/Flutter/.last_build_id
app.*.symbols
app.*.map.json
/android/app/debug
/android/app/profile
/android/app/release

# Ephemeral scratch & extract files
extracted_prd.txt
scratch/
graphify-out/

# Admin-uploaded media (product photos, promotion visuals). Stored on
# disk by the API; the database only holds the URL.
backend/api/uploads/
uploads/
*.tsbuildinfo

# Agent tooling caches and generated media. These are local scratch, not
# project source: the skill bundles duplicate themselves across .claude/ and
# .agents/, and brag-output/ holds rendered video (a single brag.mp4 is 30 MB).
# Git keeps every blob forever, so these must never enter history.
.claude/
.agents/
brag-output/
brag-output-*/
skills-lock.json

# Firebase service-account keys (secrets: they go in Coolify, never in git)
*firebase-adminsdk*.json
